# Variables de entorno para emede en Docker

# Puerto donde escucha el servidor (por defecto: 5178)
PORT=5178

# Interfaz donde escucha el servidor (por defecto: 0.0.0.0 para Docker)
HOST=0.0.0.0

# Directorio donde se guarda ~/.emede/emede.json (por defecto: /data/.emede)
EMEDE_DATA_DIR=/data/.emede

# Variables opcionales para configuración adicional
# (puedes agregar más según la documentación de la aplicación)
